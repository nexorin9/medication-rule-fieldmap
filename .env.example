# 合理用药审方字段对照系统 · 环境变量样例
# 复制为 .env 后按院内实际填写；本文件不含任何真实密钥，不得写入真实值后入库。
# 所有凭据一律从环境变量读取，程序不硬编码、不从配置文件读密钥。
# 本文件所有取值一律留空：路径类变量的内置默认值集中在 src/med_rule_fieldmap/config.py
# 的模块级常量里，环境变量为空时自动回落到该默认值。

# ---- 出站：HIS 审方复核回写 ----
# 基址；未配置时守护进程显式失败并退出，不静默跳过
HIS_BASE_URL=
# 回写令牌；请求头为 Authorization: Bearer $HIS_API_TOKEN；缺失时拒绝发出请求并告警
HIS_API_TOKEN=

# ---- 出站：企业微信群机器人推送 ----
# 缺失或非法时推送告警，不阻断判定与回写主流程
WECOM_WEBHOOK_URL=

# ---- 入站：HIS 医嘱落地目录（只读）；内置默认 ./inbox ----
MRFM_INBOX_DIR=

# ---- 出站产物目录；内置默认 ./out ----
MRFM_OUT_DIR=

# ---- 状态库（SQLite，WAL）；内置默认 ./state/mrfm.sqlite3 ----
MRFM_STATE_DB=

# ---- 规则行目录（按文件 mtime 热重载）；内置默认 ./rules ----
MRFM_RULES_DIR=

# ---- 心跳行打印间隔（秒）；内置默认 30 ----
MRFM_HEARTBEAT_SEC=
